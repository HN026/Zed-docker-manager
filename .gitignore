# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which will thus
# fall under the "target" folder, but are worth ignoring
*.pdb

# Editor directories and files
.idea
.vscode
*.swp
*.swo
.DS_Store
